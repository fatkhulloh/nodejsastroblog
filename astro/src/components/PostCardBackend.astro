---
import { slugify, formatDate } from "../js/utils";
import { Image } from "astro:assets";
import Link from "./Link.astro";

const { project } = Astro.props;
const { title,documentId, date, author, category, image, description, shortdescription } = project;

// URL halaman project
const url = `/backend/posts/${slugify(documentId)}`;

// Data image
let imageData = null;
if (image) {
  const src = `http://localhost:1337${image.formats?.thumbnail?.url || image.url}`;
  const alt = image.alternativeText || title;
  imageData = { src, alt };
}
---
<article class="card card-adjusted">
  <div class="badge-container">
    <small>
      <a href={`/backend/category/${slugify(category || 'uncategorized')}`} class="badge">
        {category || 'Uncategorized'}
      </a>
    </small>
  </div>

  {imageData ? (
    <a href={url} class="card-image-link">
      <Image
        src={imageData.src}
        alt={imageData.alt}
        width={400}
        height={200}
        format="webp"
        fit="cover"
        style="width:100%; height:100%; object-fit:cover; min-height:200px"
      />
    </a>
  ) : (
    <div class="card-image-placeholder-consistent"></div>
  )}

  <div class="content content-adjusted">
    <div class="text-wrapper">
      <h3><a href={url}>{title}</a></h3>
      <small>by <a href={`/backend/author/${slugify(author)}`}>{author}</a> {formatDate(date)}</small>
      {shortdescription
        ? <p class="shortdesc">{shortdescription}</p>
        : <p class="shortdesc empty">&nbsp;</p>
      }
    </div>
    <Link href={url} text="Read Post" style="secondary" />
  </div>
</article>

<style>
.card-adjusted {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 300px;
  width: 340px;
  height: 450px;
  background-color: hsl(var(--muted));
  border-radius: var(--radius-md);
  overflow: visible; /* pastikan badge tidak terpotong */
  box-shadow: var(--shadow-sm);
}

.badge-container {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 20;
  background-color: hsl(var(--accent));
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  color: hsl(var(--txt-on-accent));
  font-size: var(--fs-2xs);
  font-weight: 600;
}

.card-image-link,
.card-image-placeholder-consistent {
  flex: 0 0 200px;
  width: 100%;
  display: block;
  border-top-left-radius: var(--radius-md);
  border-top-right-radius: var(--radius-md);
  min-height: 200px;
}

.card-image-placeholder-consistent {
  background-color: hsl(var(--muted-light));
}

.content-adjusted {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  width: 100%;
  padding: var(--space-sm);
}

.text-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
  width: 100%;
}

.shortdesc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--fs-sm);
  line-height: var(--lh-1-4);
  margin: 0;
  min-height: calc(var(--fs-sm) * var(--lh-1-4) * 2);
}

.shortdesc.empty {
  min-height: calc(var(--fs-sm) * var(--lh-1-4) * 2);
}

.card h3 a {
  text-decoration: none;
  color: hsl(var(--txt));
}

.card h3 a:hover {
  color: hsl(var(--accent));
}

@media (max-width: 480px) {
  .card-adjusted {
    width: 90%;
    min-width: 280px;
    height: 400px;
  }
  .card-image-link,
  .card-image-placeholder-consistent {
    flex: 0 0 180px;
  }
}
</style>
