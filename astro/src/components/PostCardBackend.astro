---
import { slugify, formatDate } from "../js/utils";
import { Image } from "astro:assets";
import Link from "./Link.astro";

const { project } = Astro.props;
const { title, date, author, category, image, description, shortdescription } = project;

// URL halaman project
const url = `/projects/${slugify(title)}`;

// Data image
let imageData = null;
if (image) {
  const src = `http://localhost:1337${image.formats?.thumbnail?.url || image.url}`;
  const alt = image.alternativeText || title;
  imageData = { src, alt };
}
---
<article class="card card-adjusted">
  <div class="badge-container">
    <small>
      <a href={`/backend/category/${slugify(category)}`} class="badge">{category}</a>
    </small>
  </div>

  {imageData && (
    <a href={url} aria-hidden="true" tabindex="-1" class="card-image-link">
      <Image
        src={imageData.src}
        alt={imageData.alt}
        width={400}
        height={200}
        format="webp"
        fit="cover"
        style="width:100%; height:100%; object-fit:cover;"
      />
    </a>
  )}

  <div class="content content-adjusted">
    <div class="text-wrapper">
      <h3 class="h3"><a href={url}>{title}</a></h3>
      <small>by <a href={`/author/${slugify(author)}`}>{author}</a> {formatDate(date)}</small>
      {shortdescription && <p class="shortdesc">{shortdescription}</p>}
      {!shortdescription && <p class="shortdesc empty">&nbsp;</p>}
    </div>
    <Link href={url} text="Read Post" style="secondary" />
  </div>
</article>

<style>
.card-adjusted {
  display: flex;
  flex-direction: column;
  min-width: 300px;   /* pastikan width minimum */
  width: 340px;       /* default width */
  height: 450px;
  background-color: hsl(var(--muted));
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.card-image-link {
  flex: 0 0 45%;
  display: block;
  width: 100%;
  overflow: hidden;
}

.content-adjusted {
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* text di atas, tombol di bawah */
  flex: 1;
  width: 100%; /* pastikan content lebar penuh */
  padding: var(--space-sm);
}

.text-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
  width: 100%; /* isi penuh horizontal */
}

.shortdesc {
  display: -webkit-box;
  -webkit-line-clamp: 2; /* maksimal 2 baris */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--fs-sm);
  margin: 0;
}

.shortdesc.empty {
  min-height: 2em; /* cadangan space saat kosong */
}

.badge-container {
  position: absolute;
  top: 8px;
  left: 8px;
}

.card h3 a {
  text-decoration: none;
  color: hsl(var(--txt));
}

.card h3 a:hover {
  color: hsl(var(--accent));
}

/* Responsive */
@media (max-width: 480px) {
  .card-adjusted {
    width: 90%;
    min-width: 280px;
    height: 400px;
  }

  .card-image-link {
    flex: 0 0 auto;
    height: 180px;
  }
}
</style>
