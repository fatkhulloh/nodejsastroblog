---
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";
import navData from "../data/navData";
import { useState } from "preact/hooks";
---

<nav aria-label="Primary">
  <div class="navbar">
    <!-- Logo -->
    <a href="/" class="logomark" aria-label="Go Home">
      <Icon name="logomark" width={50}/>
    </a>

    <!-- Desktop Menu -->
    <ul class="nav-links">
      {navData.map((item) => (
        <li>
          <Link 
            text={item.name}
            href={item.path}
            style="primary"
            isFilled={false}
            data-navLink
          />
        </li>
      ))}
    </ul>

    <!-- Buttons kanan atas -->
    <div class="nav-buttons">
      <Link text="Login" href="/login" style="secondary" isFilled={true} />
      <Link text="Register" href="/register" style="primary" isFilled={true} />
    </div>

    <!-- Hamburger untuk mobile -->
    <button class="hamburger" aria-label="Menu" onClick={() => setOpen(!open)}>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Mobile menu dropdown -->
    <ul class="mobile-menu">
      {navData.map((item) => (
        <li>
          <Link 
            text={item.name}
            href={item.path}
            style="primary"
            isFilled={false}
            data-navLink
          />
        </li>
      ))}
    </ul>
  </div>
</nav>

<script type="module">
  import { useState } from "preact/hooks";
  const [open, setOpen] = useState(false);
</script>

<style>
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background-color: hsl(var(--bg-dark));
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  position: relative;
  z-index: 50;
}

/* Logo */
.logomark {
  display: flex;
  align-items: center;
  color: hsl(var(--txt-light));
  text-decoration: none;
}

/* Desktop Menu */
.nav-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links li a {
  color: hsl(var(--txt-light));
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}

.nav-links li a:hover {
  color: hsl(var(--accent));
}

/* Buttons kanan atas */
.nav-buttons {
  display: flex;
  gap: 0.75rem;
}

.nav-buttons a {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm);
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
}

.nav-buttons a[style="primary"] {
  background-color: hsl(var(--accent));
  color: hsl(var(--txt-inverse));
}

.nav-buttons a[style="primary"]:hover {
  background-color: hsl(var(--accent-hover));
}

.nav-buttons a[style="secondary"] {
  background-color: transparent;
  border: 1px solid hsl(var(--accent));
  color: hsl(var(--accent));
}

.nav-buttons a[style="secondary"]:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--txt-inverse));
}

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 18px;
  background: none;
  border: none;
  cursor: pointer;
}

.hamburger span {
  display: block;
  height: 3px;
  background-color: hsl(var(--txt-light));
  border-radius: 2px;
}

/* Mobile menu */
.mobile-menu {
  display: none;
  flex-direction: column;
  position: absolute;
  top: 100%;
  right: 0;
  background-color: hsl(var(--bg-dark));
  width: 200px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.mobile-menu li {
  padding: 0.75rem 1rem;
}

.mobile-menu li a {
  color: hsl(var(--txt-light));
}

.mobile-menu li a:hover {
  color: hsl(var(--accent));
}

/* Responsive */
@media (max-width: 768px) {
  .nav-links {
    display: none;
  }

  .hamburger {
    display: flex;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
  }
}
</style>
