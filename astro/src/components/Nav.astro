---
// Navbar.astro
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";
import navData from "../data/navData";
---

<nav aria-label="Primary">
  <div class="navbar">
    <!-- Logo -->
    <a href="/" class="logomark" aria-label="Go Home">
      <Icon name="logomark" width={50}/>
    </a>

    <!-- Desktop Menu -->
    <ul class="nav-links">
      {navData.map((item) => (
        <li>
          <Link 
            text={item.name}
            href={item.path}
            style="primary"
            isFilled={false}
            data-navLink
          />
        </li>
      ))}
    </ul>

    <!-- Buttons / User menu kanan atas -->
    <div class="nav-buttons" id="navButtons">
      <Link text="Login" href="/login" style="secondary" isFilled={true} id="loginBtn"/>
      <Link text="Register" href="/register" style="primary" isFilled={true} id="registerBtn"/>
      
      <!-- User dropdown -->
      <div class="user-menu" id="userMenu" style="display:none;">
        <button id="usernameBtn">Username</button>
        <ul class="dropdown" id="dropdownMenu">
          <li><button id="logoutBtn">Logout</button></li>
        </ul>
      </div>
    </div>

    <!-- Hamburger untuk mobile -->
    <button class="hamburger" aria-label="Menu" id="hamburgerBtn">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Mobile menu dropdown -->
    <ul class="mobile-menu" id="mobileMenu">
      {navData.map((item) => (
        <li>
          <Link 
            text={item.name}
            href={item.path}
            style="primary"
            isFilled={false}
            data-navLink
          />
        </li>
      ))}
    </ul>
  </div>
</nav>

<script type="module">
  // Navbar link aktif
  const navLinks = document.querySelectorAll("[data-navLink]");
  navLinks.forEach((link) => {
    if (link.getAttribute("href") === window.location.pathname) {
      link.setAttribute("aria-current", "page");
    }
  });

  // Cek JWT di localStorage
  const dataStr = localStorage.getItem("data");
  const loginBtn = document.getElementById("loginBtn");
  const registerBtn = document.getElementById("registerBtn");
  const userMenu = document.getElementById("userMenu");
  const usernameBtn = document.getElementById("usernameBtn");
  const dropdownMenu = document.getElementById("dropdownMenu");
  const logoutBtn = document.getElementById("logoutBtn");

  if (dataStr) {
    try {
      const data = JSON.parse(dataStr);
      // sembunyikan login/register
      loginBtn.style.display = "none";
      registerBtn.style.display = "none";
      
      // tampilkan username
      usernameBtn.textContent = data.user.username || data.user.email;
      userMenu.style.display = "flex";

    } catch (err) {
      console.error("Error parsing data:", err);
    }
  }

  // Toggle dropdown
  usernameBtn.addEventListener("click", () => {
    dropdownMenu.style.display = dropdownMenu.style.display === "block" ? "none" : "block";
  });

  // Logout
  logoutBtn.addEventListener("click", () => {
    localStorage.removeItem("data");
    window.location.reload();
  });

  // klik di luar dropdown menutup dropdown
  document.addEventListener("click", (e) => {
    if (!userMenu.contains(e.target)) {
      dropdownMenu.style.display = "none";
    }
  });

  // Hamburger menu toggle
  const hamburgerBtn = document.getElementById("hamburgerBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  hamburgerBtn.addEventListener("click", () => {
    mobileMenu.style.display = mobileMenu.style.display === "flex" ? "none" : "flex";
  });

  // Hide mobile menu saat resize ke desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth > 768) {
      mobileMenu.style.display = "none";
    }
  });
</script>

<style>
/* Navbar umum */

/* Override khusus untuk username di navbar */
.user-menu #usernameBtn {
  width: auto;            /* biar mengikuti panjang username */
  min-width: 6rem;        /* optional, supaya tidak terlalu kecil */
  height: auto;           /* menyesuaikan padding */
  padding: 0.5rem 1rem;   /* ruang di dalam tombol */
  display: inline-flex;
  align-items: center;
  justify-content: space-between; /* jika mau icon dropdown */
  /* background-color: hsl(var(--accent)); */
  /* background-color: gray; */
  color: hsl(var(--txt-inverse));
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
}
.user-menu .dropdown {
  /* top: calc(100% + 0.25rem);  */
  top: calc(100% + 0.65rem); /* beri jarak dari tombol */
  right: 0;
  min-width: 140px;          /* lebih lebar */
  max-width: 250px;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background-color: hsl(var(--bg-dark));
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  position: relative;
  z-index: 50;
}

/* Logo */
.logomark {
  display: flex;
  align-items: center;
  color: hsl(var(--txt-light));
  text-decoration: none;
}

/* Desktop Menu */
.nav-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links li a {
  color: hsl(var(--txt-light));
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}

.nav-links li a:hover {
  color: hsl(var(--accent));
}

.nav-links li a[aria-current="page"] {
  color: hsl(var(--accent));
  font-weight: 700;
}

/* Buttons kanan atas */
.nav-buttons {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.nav-buttons a {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm);
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
}

.nav-buttons a[style="primary"] {
  background-color: hsl(var(--accent));
  color: hsl(var(--txt-inverse));
}

.nav-buttons a[style="primary"]:hover {
  background-color: hsl(var(--accent-hover));
}

.nav-buttons a[style="secondary"] {
  background-color: transparent;
  border: 1px solid hsl(var(--accent));
  color: hsl(var(--accent));
}

.nav-buttons a[style="secondary"]:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--txt-inverse));
}

/* User menu */
.user-menu {
  position: relative;
  display: flex;
  align-items: center;
}

#usernameBtn {
  background: none;
  border: none;
  color: hsl(var(--txt-light));
  font-weight: 500;
  cursor: pointer;
  padding: 0.5rem 1rem;
}

#usernameBtn:hover {
  color: hsl(var(--accent));
}

.dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  background-color: hsl(var(--bg-dark));
  border-radius: var(--radius-sm);
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  overflow: hidden;
  min-width: 120px;
  display: none;
  flex-direction: column;
}

.dropdown li button {
  width: 100%;
  padding: 0.5rem 1rem;
  background: none;
  border: none;
  text-align: left;
  color: hsl(var(--txt-light));
  cursor: pointer;
}

.dropdown li button:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--txt-inverse));
}

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 18px;
  background: none;
  border: none;
  cursor: pointer;
}

.hamburger span {
  display: block;
  height: 3px;
  background-color: hsl(var(--txt-light));
  border-radius: 2px;
}

/* Mobile menu */
.mobile-menu {
  display: none;
  flex-direction: column;
  position: absolute;
  top: 100%;
  right: 0;
  background-color: hsl(var(--bg-dark));
  width: 200px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.mobile-menu li a {
  color: hsl(var(--txt-light));
  padding: 0.75rem 1rem;
  display: block;
  text-decoration: none;
}

.mobile-menu li a:hover {
  color: hsl(var(--accent));
}

/* Responsive */
@media (max-width: 768px) {
  .nav-links {
    display: none;
  }
  .hamburger {
    display: flex;
  }
}
</style>
