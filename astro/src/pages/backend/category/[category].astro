---
import MainLayout from "../../../layouts/MainLayout.astro";
import PostCardBackend from "../../../components/PostCardBackend.astro";

// 1️⃣ Ambil semua project di getStaticPaths
export async function getStaticPaths() {
  const res = await fetch("http://localhost:1337/api/projects?populate=image");
  const json = await res.json();
console.log("Panggil");
  console.log("Json3: ", json);
  // generate paths dari daftar kategori di JSON
 const categories = [...new Set(
  json.data.map(p => p.category.toLowerCase())
)];


  // kirim seluruh JSON ke page, tidak ada filter
  return categories.map(category => ({
    params: { category },
    props: { projects: json.data }, // kirim semua project
  }));
}

// 2️⃣ Ambil category dari URL & semua project dari props
const { category } = Astro.params;
const { projects } = Astro.props;

// 3️⃣ Bisa filter/log di sini bebas
console.log("Paramsnya: ", category)
console.log("Semua projects (belum difilter):", projects);

// opsional filter di sini kalau mau
const posts = projects.filter(
  p => p.category.toLowerCase() === category
);

// // buat title readable
const categoryTitle = category.replace(/-/g, " ").replace(/\b\w/g, l => l.toUpperCase());
---

<MainLayout title={categoryTitle}> -->
  <section class="container" aria-label={`Posts about ${categoryTitle}`}>
    <h1 class="h1">
      Posts about <span>{categoryTitle}</span>
    </h1>

    <div class="post-container">
      {posts.length === 0 && <p>No posts found in this category.</p>}

      {posts.map(post => (
             <PostCardBackend project = {post}/>
      ))}
    </div>
  </section>
</MainLayout>
