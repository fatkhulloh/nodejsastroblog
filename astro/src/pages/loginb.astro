---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main class="login-page">
    <div class="login-container">
      <h1 class="hh">Login</h1>

      <form id="loginForm" class="login-form" method="post">
        <label for="identifier">Email</label>
        <input type="email" id="identifier" name="identifier" placeholder="you@example.com" required />

        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required />

        <button type="submit" class="btn-login">Login</button>
        <p id="loginMessage"></p>
      </form>

      <p class="register-text">
        Belum punya akun? <a href="/register">Register</a>
      </p>
    </div>
  </main>

  <script type="module">
    const form = document.getElementById('loginForm');
    const message = document.getElementById('loginMessage');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const identifier = formData.get('identifier');
      const password = formData.get('password');

      console.log("UserName: ", identifier);
      console.log("Password: ", password);
      try {
        const res = await fetch('http://localhost:1337/api/auth/local', {
        // const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, password })
        });

        const data = await res.json();

        console.log("Datanya: ", data);
        if (!res.ok) {
          message.textContent = `Login gagal: ${data.error || data.message}`;
          message.style.color = 'red';
          return;
        }

        // localStorage.setItem('token', data.jwt);
        message.textContent = `Login berhasil! Halo ${data.user.username || data.user.email}`;
        message.style.color = 'green';
        // form.reset();
      } catch (err) {
        message.textContent = `Error: ${err.message}`;
        message.style.color = 'red';
      }
    });
  </script>
</MainLayout>
