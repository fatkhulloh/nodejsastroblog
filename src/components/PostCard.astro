---
import { slugify, formatDate } from "../js/utils";
import { Image } from "astro:assets";
import Link from "./Link.astro";

const { frontmatter, url, tagType } = Astro.props;
const { title, date, author, category, image, description } = frontmatter;
const Tag = tagType;
---

<article class="card">
  <div class="badge-container">
    <small>
      <a href={`/category/${category}`} class="badge">{category}</a>
    </small>
  </div>

  <a href={url} aria-hidden="true" tabindex="-1">
    <Image
      src={image.src}
      alt={image.alt}
      width={400}
      height={250}
      format="webp"
      fit="cover"
      style="width:100%; height:auto;"
      aspect-ratio="4:1"
    />
  </a>

  <div class="content">
    <div>
      <Tag class="h3">
        <a href={url}>{title}</a>
      </Tag>
      <small>
        by <a href={`/author/${slugify(author)}`}>{author}</a> {formatDate(date)}
      </small>
    </div>
    <p>{description}</p>
    <Link href={url} text="Read Post" style="secondary" />
  </div>
</article>
