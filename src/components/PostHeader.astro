---
const { title, date, category, image, author } = Astro.props;
import {slugify, formatDate} from "../js/utils"
import { Image } from "astro:assets";
---

<header>
    <div class="container">
        <small>
            <a href={`/category/${category}`} class="badge">{category}</a>
        </small>
        <h1 class="h2">{title}</h1>
        <p>by <a href={`author/${slugify(author)}`}>{author}</a> {formatDate(date)}</p>
    </div>
    <Image src={image.src} alt={image.alt}
        width={1200}
        height={500}       
        format="avif"
        fit="cover"
        quality={80}
        aspect-ratio="5/2"   
        class="hero-image"/>

</header>