---
// library imports
// import { Icon } from "astro-icon";

// component imports
import Link from "./Link.astro";

// data imports
import navData from "../data/navData";
---

<nav aria-label="Primary">
  <div class="navbar">
    <a href="/" class="logomark" aria-label="Go home">
      <!-- <img src="https://img.freepik.com/vektor-gratis/logo-vektor-gradien-warna-warni-burung_343694-1365.jpg?semt=ais_hybrid&w=740&q=80" width="60" height="60" alt="Logo" /> -->
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQhypDJb0NYfjo9Sp6vRZ-KUgmjc2XCCYxLXA&s" width="60" height="60" alt="Logo" />

      <!-- <Icon name="logomark" width="60" /> -->
    </a>
    <ul>
      {
        navData.map((item) => (
          <Link
            text={item.name}
            href={item.path}
            style="primary"
            isFilled={false}
            data-navLink
          />
        ))
      }
    </ul>
  </div>
</nav>

<script>
  import "../js/nav.js";
</script>
