---
// component imports
import Link from "../components/Link.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About" description="My About Page">
  <section class="container about" aria-label="About Me">
    <img
      src="/images/headshot.jpg"
      alt="My headshot"
      width="200"
      height="330"
    />
    <div class="content">
      <h1 class="h1">My Blog</h1>
      <p>
        Through this blog, I write about my experiences, ideas, and lessons learned in software development and technology. It serves as a space to document my growth, 
        share knowledge, and connect with others who share similar interests.
      </p>
      <!-- href="mailto:chris@codinginpublic.dev" -->
      <Link
        href="mailto:fatkhulloh6939@gmail.com"
        style="primary"
        text="Contact Me"
      />
    </div>
  </section>
</MainLayout>
